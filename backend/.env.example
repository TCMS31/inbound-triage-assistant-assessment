# Copy to backend/.env. Every value below has a working default — the app
# starts, serves the list, handles malformed messages and passes its test
# suite with this file absent entirely. Only LLM classification needs a key.

# --- LLM provider selection ---------------------------------------------
# anthropic | openai | stub | auto   (default: auto)
#   auto   uses whichever key is present, Anthropic first. Never picks stub.
#   stub   offline rule-based baseline: no key, no network, no spend. Useful
#          for UI work, demos and `scripts/evaluate.py`. Results are labelled
#          `baseline` in the API so they cannot be mistaken for model output.
LLM_PROVIDER=auto

# --- Anthropic (Claude) --------------------------------------------------
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Haiku is fast and cheap and right-sized for a four-way classification.
MODEL_ID=claude-haiku-4-5-20251001

# --- OpenAI --------------------------------------------------------------
# https://platform.openai.com/api-keys
# Requires the optional extra:  uv sync --extra openai
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini

# --- Reliability ---------------------------------------------------------
# Per-request timeout for a model call, and how many times the vendor SDK may
# retry at the transport layer before the row is reported as failed.
LLM_TIMEOUT_SECONDS=30
LLM_TRANSPORT_RETRIES=1

# --- Server --------------------------------------------------------------
# Used by `python -m triage_backend` and the container CMD.
# `fastapi dev --port N` takes its port from the CLI flag instead.
PORT=8787

# Comma-separated origins allowed to call the API cross-origin. The Vite dev
# proxy makes the browser same-origin, so this only matters for direct callers.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Data ----------------------------------------------------------------
# Override to point at a different corpus or cache location.
# INBOUND_PATH=data/inbound.json
# RESULTS_PATH=data/results.json

# --- Demo aid ------------------------------------------------------------
# Set to an inbound id (e.g. inb-005) to make that row's triage call fail, so
# the per-row error + Retry path can be demonstrated on demand instead of
# waiting for a real transient failure. Leave blank in normal use.
TRIAGE_FORCE_ERROR_ID=
