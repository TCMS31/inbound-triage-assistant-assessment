# Copy to .env next to docker-compose.yml. Compose reads it for variable
# substitution; every value has a default, so the file is optional.
# (backend/.env.example documents the same settings for running uv directly.)

# anthropic | openai | stub | auto. `stub` is the offline rule baseline:
# no key, no network, no spend, and its rows are labelled as not a model.
LLM_PROVIDER=stub

# Only needed for a real model run. Leave blank otherwise.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_ID=claude-haiku-4-5-20251001
OPENAI_MODEL_ID=gpt-4o-mini

# Force one inbound id to fail, to show the per-row error and Retry path.
TRIAGE_FORCE_ERROR_ID=

# Host ports for the UI and the API.
WEB_PORT=8761
API_PORT=8762
